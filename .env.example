# Firebase 設定
# Firebaseコンソールの「プロジェクトの設定」>「全般」>「マイアプリ」のSDK構成から取得してください。
# 未設定時は自動的にローカルストレージ・デモデータモードで動作します。

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Firebase App Check (reCAPTCHA Enterprise)
# Google Cloud Console / Firebase Console で取得した Web用スコアベース key を設定します。
# Cloudflare Workers Builds ではビルド環境変数 (Build Environment Variable) として設定してください。
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=your_recaptcha_enterprise_site_key

# [開発専用] ローカルホスト用 App Check デバッグプロバイダ
# true に設定すると、ブラウザコンソールに App Check debug token が出力されます。
# 本番環境変数には絶対に設定しないでください。
# VITE_FIREBASE_APPCHECK_DEBUG=true
