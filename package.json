{
  "name": "george",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:identity": "VITE_USE_FIREBASE_EMULATORS=true VITE_BILL_IDENTITY_V2=true vite --host 127.0.0.1 --port 5174 --strictPort",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "preview:cf": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test:rules": "firebase --config firebase.json emulators:exec --only firestore,auth \"node test/strict-rules.runner.cjs\"",
    "test:rules:strict": "firebase --config firebase.strict.json emulators:exec --only firestore,auth \"node test/strict-rules.runner.cjs\"",
    "test:rules:v2": "node test/run-identity-emulators.mjs",
    "test:google-merge": "node test/run-google-account-merge-emulator.mjs",
    "test:auth": "node --test test/anonymous-session.test.js",
    "test:serial-input": "node --test test/serial-input.test.js",
    "test:tracked-bills": "node --test test/tracked-bill-state.test.js",
    "test:appcheck": "node --test test/appcheck.test.js",
    "test:ocr": "node --test test/ocr-parser.test.js",
    "test:backup": "node test/run-backup-emulators.mjs",
    "backup:emulator": "node scripts/backup/firestore-backup.mjs",
    "backup:production": "node scripts/backup/production-backup.mjs",
    "test:backup:production": "node --test test/production-backup.test.js",
    "backup:budget": "node scripts/backup/check-budget.mjs",
    "test:backup:budget": "node --test test/read-budget.test.js",
    "dev:identity:lan": "node scripts/dev/identity-lan.mjs"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "firebase": "^12.19.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-admin": "^14.5.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.140.0"
  }
}
