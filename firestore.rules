rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // 日本円紙幣追跡「お札の旅」 Firestore Security Rules (MVP本番用)
    // ===============================================================

    // ---------------------------------------------------------------
    // 1. bills コレクション (紙幣メタデータ)
    // ---------------------------------------------------------------
    match /bills/{billId} {
      // 誰でも紙幣の検索や一覧閲覧が可能
      allow read: if true;

      // 新規紙幣の登録
      allow create: if isValidNewBill(billId);

      // 既存紙幣の再発見（トランザクションによる集計値更新）
      allow update: if isValidBillUpdate();

      // 紙幣の削除は禁止
      allow delete: if false;
    }

    function isValidNewBill(billId) {
      let data = request.resource.data;

      return request.resource.id == billId
        // ドキュメントIDと記番号の一致および日本銀行券の正規化形式検証
        && data.id == billId
        && data.serialNumber == billId
        && data.serialNumber.matches('^[A-Z]{1,2}[0-9]{6}[A-Z]{1,2}$')
        
        // 額面は 1000円 / 5000円 / 10000円 のいずれか
        && data.denomination in [1000, 5000, 10000]
        
        // 初回登録時の初期値
        && data.sightingsCount == 1
        && data.totalDistanceKm == 0
        
        // 日時フィールド（ISO8601文字列）の検証
        && data.createdAt is string && data.createdAt.size() >= 19 && data.createdAt.size() <= 32
        && data.updatedAt is string && data.updatedAt.size() >= 19 && data.updatedAt.size() <= 32
        && data.firstSightedAt is string && data.firstSightedAt.size() >= 19 && data.firstSightedAt.size() <= 32
        && data.lastSightedAt is string && data.lastSightedAt.size() >= 19 && data.lastSightedAt.size() <= 32
        // 移行中は旧形式（時計なし）も許可する。新形式はサーバー時刻を必須検証する。
        && ((!('lastSightedAtServer' in data)
              && data.keys().hasAll(['id', 'serialNumber', 'denomination', 'createdAt', 'updatedAt', 'sightingsCount', 'totalDistanceKm', 'firstSightedAt', 'lastSightedAt'])
              && data.keys().hasOnly(['id', 'serialNumber', 'denomination', 'createdAt', 'updatedAt', 'sightingsCount', 'totalDistanceKm', 'firstSightedAt', 'lastSightedAt']))
          || ('lastSightedAtServer' in data
              && data.lastSightedAtServer is timestamp
              && data.lastSightedAtServer == request.time
              && data.keys().hasAll(['id', 'serialNumber', 'denomination', 'createdAt', 'updatedAt', 'sightingsCount', 'totalDistanceKm', 'firstSightedAt', 'lastSightedAt', 'lastSightedAtServer'])
              && data.keys().hasOnly(['id', 'serialNumber', 'denomination', 'createdAt', 'updatedAt', 'sightingsCount', 'totalDistanceKm', 'firstSightedAt', 'lastSightedAt', 'lastSightedAtServer'])));
    }

    function isValidBillUpdate() {
      let current = resource.data;
      let next = request.resource.data;

      let immutableFields =
        // 改ざんを禁止する不変フィールド
        next.id == current.id
        && next.serialNumber == current.serialNumber
        && next.denomination == current.denomination
        && next.createdAt == current.createdAt
        && next.firstSightedAt == current.firstSightedAt;

      let validRediscoveryBase =
        // 発見回数は現在値 + 1 のみ許可（ジャンプや減少を防止）
        next.sightingsCount == current.sightingsCount + 1
        
        // 移動距離は減少不可かつ非負数
        && next.totalDistanceKm is number
        && next.totalDistanceKm >= current.totalDistanceKm
        
        // 更新日時フィールドの検証
        && next.updatedAt is string && next.updatedAt.size() >= 19 && next.updatedAt.size() <= 32
        && next.lastSightedAt is string && next.lastSightedAt.size() >= 19 && next.lastSightedAt.size() <= 32
        ;

      let newClientRediscovery =
        'lastSightedAtServer' in current
        && 'lastSightedAtServer' in next
        && next.lastSightedAtServer is timestamp
        && next.lastSightedAtServer == request.time
        && request.time >= current.lastSightedAtServer + duration.value(15, 'm')
        && next.keys().hasAll(['id', 'serialNumber', 'denomination', 'createdAt', 'updatedAt', 'sightingsCount', 'totalDistanceKm', 'firstSightedAt', 'lastSightedAt', 'lastSightedAtServer'])
        && next.keys().hasOnly(['id', 'serialNumber', 'denomination', 'createdAt', 'updatedAt', 'sightingsCount', 'totalDistanceKm', 'firstSightedAt', 'lastSightedAt', 'lastSightedAtServer']);

      // New-client initializer: add only the server clock. This starts the 15-minute window.
      let initializeLegacyCooldown =
        !('lastSightedAtServer' in current)
        && 'lastSightedAtServer' in next
        && next.lastSightedAtServer is timestamp
        && next.lastSightedAtServer == request.time
        && next.diff(current).affectedKeys().hasOnly(['lastSightedAtServer']);

      // Temporary migration compatibility: legacy writes do not update the server clock.
      // The 15-minute cooldown cannot be fully guaranteed on this old-client path.
      let legacyClientRediscovery =
        validRediscoveryBase
        && (!('lastSightedAtServer' in current)
          ? !('lastSightedAtServer' in next)
          : ('lastSightedAtServer' in next
            && next.lastSightedAtServer == current.lastSightedAtServer
            && !next.diff(current).affectedKeys().hasAny(['lastSightedAtServer'])))
        && next.keys().hasAll(['id', 'serialNumber', 'denomination', 'createdAt', 'updatedAt', 'sightingsCount', 'totalDistanceKm', 'firstSightedAt', 'lastSightedAt'])
        && next.keys().hasOnly(['id', 'serialNumber', 'denomination', 'createdAt', 'updatedAt', 'sightingsCount', 'totalDistanceKm', 'firstSightedAt', 'lastSightedAt', 'lastSightedAtServer']);

      return immutableFields
        && (initializeLegacyCooldown
          || (validRediscoveryBase && newClientRediscovery)
          || legacyClientRediscovery);
    }

    // ---------------------------------------------------------------
    // 2. sightings コレクション (発見記録)
    // ---------------------------------------------------------------
    match /sightings/{sightingId} {
      // 誰でも移動履歴の閲覧が可能
      allow read: if true;

      // 新規発見記録の登録
      allow create: if isValidNewSighting();

      // 過去の発見記録の改ざん・削除は完全禁止
      allow update: if false;
      allow delete: if false;
    }

    function isValidNewSighting() {
      let data = request.resource.data;
      let targetBillDoc = getAfter(/databases/$(database)/documents/bills/$(data.billId));
      let billPath = /databases/$(database)/documents/bills/$(data.billId);
      let billBefore = get(billPath);
      let hasBillBefore = exists(billPath);
      let clockChanged = (!hasBillBefore && 'lastSightedAtServer' in targetBillDoc.data)
        || (hasBillBefore
          && targetBillDoc.data.diff(billBefore.data).affectedKeys().hasAny(['lastSightedAtServer']));

      return (
        // トランザクションコミット後に対応する bills/{billId} が存在すること
        existsAfter(/databases/$(database)/documents/bills/$(data.billId))
        
        // トランザクション整合性: sightingのstepとbillのsightingsCountが完全に連動していること
        && data.step == targetBillDoc.data.sightingsCount
        && ((!hasBillBefore && data.step == 1)
          || (hasBillBefore && data.step == billBefore.data.sightingsCount + 1))
        // New-client writes must advance the trusted server clock to request.time.
        // The old-client compatibility branch keeps the clock unchanged (or absent);
        // cooldown cannot be fully enforced for that temporary legacy path.
        && ((clockChanged
              && targetBillDoc.data.lastSightedAtServer is timestamp
              && targetBillDoc.data.lastSightedAtServer == request.time)
          || (!clockChanged
              && ((!hasBillBefore && !('lastSightedAtServer' in targetBillDoc.data))
                || (hasBillBefore
                  && ((!('lastSightedAtServer' in billBefore.data) && !('lastSightedAtServer' in targetBillDoc.data))
                    || ('lastSightedAtServer' in billBefore.data
                      && 'lastSightedAtServer' in targetBillDoc.data
                      && targetBillDoc.data.lastSightedAtServer == billBefore.data.lastSightedAtServer))))))
        
        // 基本フィールド型とフォーマット
        && data.id is string
        && data.billId is string && data.billId.matches('^[A-Z]{1,2}[0-9]{6}[A-Z]{1,2}$')
        && data.step is int && data.step >= 1
        
        // 地域（市区町村レベル）
        && data.prefecture is string && data.prefecture.size() >= 2 && data.prefecture.size() <= 10
        && data.municipality is string && data.municipality.size() >= 1 && data.municipality.size() <= 50
        
        // 概算座標範囲（世界標準範囲）
        && data.latitudeApprox is number && data.latitudeApprox >= -90.0 && data.latitudeApprox <= 90.0
        && data.longitudeApprox is number && data.longitudeApprox >= -180.0 && data.longitudeApprox <= 180.0
        
        // 移動・経過メトリクス（非負数）
        && data.distanceFromPrevKm is number && data.distanceFromPrevKm >= 0
        && data.daysFromPrev is number && data.daysFromPrev >= 0
        
        // 日時文字列（ISO8601）
        && data.createdAt is string && data.createdAt.size() >= 19 && data.createdAt.size() <= 32
        
        // 旅メモ（任意入力・最大100文字）
        && (!('userNote' in data) || (data.userNote is string && data.userNote.size() <= 100))
        
        // フィールドキーの完全一致
        && data.keys().hasAll(['id', 'billId', 'step', 'prefecture', 'municipality', 'latitudeApprox', 'longitudeApprox', 'createdAt', 'distanceFromPrevKm', 'daysFromPrev'])
        && data.keys().hasOnly(['id', 'billId', 'step', 'prefecture', 'municipality', 'latitudeApprox', 'longitudeApprox', 'createdAt', 'distanceFromPrevKm', 'daysFromPrev', 'userNote'])
      );
    }

    // Temporary rollout compatibility: old clients may keep writing public bill/sighting
    // documents without a rate-limit document. New clients can update their own counter
    // in the same transaction; when they do, that private write is validated as strictly
    // as in firestore.strict.rules. Strict Rules remain the final enforcement stage.
    function hasRateLimitFields(data) {
      return data.keys().hasAll([
          'shortWindowStartedAt', 'shortCount', 'dailyWindowStartedAt', 'dailyCount',
          'updatedAt', 'lastOperationBillId', 'lastOperationSightingId'
        ])
        && data.keys().hasOnly([
          'shortWindowStartedAt', 'shortCount', 'dailyWindowStartedAt', 'dailyCount',
          'updatedAt', 'lastOperationBillId', 'lastOperationSightingId'
        ])
        && data.shortWindowStartedAt is timestamp
        && data.shortCount is int && data.shortCount >= 1 && data.shortCount <= 10
        && data.dailyWindowStartedAt is timestamp
        && data.dailyCount is int && data.dailyCount >= 1 && data.dailyCount <= 50
        && data.updatedAt is timestamp && data.updatedAt == request.time
        && data.lastOperationBillId is string
        && data.lastOperationBillId.matches('^[A-Z]{1,2}[0-9]{6}[A-Z]{1,2}$')
        && data.lastOperationSightingId is string
        && data.lastOperationSightingId.size() >= 1
        && data.lastOperationSightingId.size() <= 150;
    }

    function isInitialRateLimit(data) {
      return hasRateLimitFields(data)
        && data.shortWindowStartedAt == request.time
        && data.shortCount == 1
        && data.dailyWindowStartedAt == request.time
        && data.dailyCount == 1;
    }

    function isValidRateLimitAdvance(before, after) {
      return hasRateLimitFields(after)
        && before.shortWindowStartedAt is timestamp
        && before.shortCount is int && before.shortCount >= 1 && before.shortCount <= 10
        && before.dailyWindowStartedAt is timestamp
        && before.dailyCount is int && before.dailyCount >= 1 && before.dailyCount <= 50
        && after.diff(before).affectedKeys().hasOnly([
          'shortWindowStartedAt', 'shortCount', 'dailyWindowStartedAt', 'dailyCount',
          'updatedAt', 'lastOperationBillId', 'lastOperationSightingId'
        ])
        && (request.time < before.shortWindowStartedAt + duration.value(10, 'm')
          ? (after.shortWindowStartedAt == before.shortWindowStartedAt
            && after.shortCount == before.shortCount + 1)
          : (after.shortWindowStartedAt == request.time && after.shortCount == 1))
        && (request.time < before.dailyWindowStartedAt + duration.value(24, 'h')
          ? (after.dailyWindowStartedAt == before.dailyWindowStartedAt
            && after.dailyCount == before.dailyCount + 1)
          : (after.dailyWindowStartedAt == request.time && after.dailyCount == 1));
    }

    function hasValidRateLimitOperationPair(data) {
      let billPath = /databases/$(database)/documents/bills/$(data.lastOperationBillId);
      let sightingPath = /databases/$(database)/documents/sightings/$(data.lastOperationSightingId);
      let billAfter = getAfter(billPath).data;
      let sightingAfter = getAfter(sightingPath).data;
      return existsAfter(billPath)
        && existsAfter(sightingPath)
        && !exists(sightingPath)
        && billAfter.id == data.lastOperationBillId
        && sightingAfter.id == data.lastOperationSightingId
        && sightingAfter.billId == data.lastOperationBillId
        && ((!exists(billPath) && billAfter.sightingsCount == 1)
          || (exists(billPath)
            && billAfter.sightingsCount == get(billPath).data.sightingsCount + 1));
    }

    match /rateLimits/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && isInitialRateLimit(request.resource.data)
        && hasValidRateLimitOperationPair(request.resource.data);
      allow update: if request.auth != null
        && request.auth.uid == uid
        && isValidRateLimitAdvance(resource.data, request.resource.data)
        && hasValidRateLimitOperationPair(request.resource.data);
      allow delete: if false;
    }

    // Private per-browser/device state. Public bills and sightings never store a UID.
    match /users/{uid}/trackedBills/{billId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['billId', 'createdAt', 'firstRegisteredByMe', 'notifyOnRediscovery'])
        && request.resource.data.keys().hasOnly(['billId', 'createdAt', 'firstRegisteredByMe', 'notifyOnRediscovery', 'lastSeenSightingsCount', 'lastSeenAt', 'lastSeenMunicipality'])
        && request.resource.data.billId == billId
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt == request.time
        && request.resource.data.firstRegisteredByMe == true
        && request.resource.data.notifyOnRediscovery is bool
        && (!('lastSeenSightingsCount' in request.resource.data)
          || (request.resource.data.lastSeenSightingsCount is int && request.resource.data.lastSeenSightingsCount >= 0))
        && (!('lastSeenAt' in request.resource.data)
          || (request.resource.data.lastSeenAt is timestamp && request.resource.data.lastSeenAt == request.time))
        && (!('lastSeenMunicipality' in request.resource.data)
          || (request.resource.data.lastSeenMunicipality is string
            && request.resource.data.lastSeenMunicipality.size() >= 1
            && request.resource.data.lastSeenMunicipality.size() <= 50));
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['billId', 'createdAt', 'firstRegisteredByMe', 'notifyOnRediscovery', 'lastSeenSightingsCount', 'lastSeenAt', 'lastSeenMunicipality'])
        && request.resource.data.billId == resource.data.billId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.firstRegisteredByMe == resource.data.firstRegisteredByMe
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notifyOnRediscovery', 'lastSeenSightingsCount', 'lastSeenAt', 'lastSeenMunicipality'])
        && (!('notifyOnRediscovery' in request.resource.data) || request.resource.data.notifyOnRediscovery is bool)
        && (!('lastSeenSightingsCount' in request.resource.data)
          || (request.resource.data.lastSeenSightingsCount is int && request.resource.data.lastSeenSightingsCount >= 0))
        && (!('lastSeenAt' in request.resource.data)
          || (request.resource.data.lastSeenAt is timestamp
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastSeenAt'])
              || request.resource.data.lastSeenAt == request.time)))
        && (!('lastSeenMunicipality' in request.resource.data)
          || (request.resource.data.lastSeenMunicipality is string
            && request.resource.data.lastSeenMunicipality.size() >= 1
            && request.resource.data.lastSeenMunicipality.size() <= 50));
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // デフォルト: 他のコレクションへのアクセスは拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
